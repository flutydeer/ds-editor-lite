/* Panel Tool Bar */
ClipEditorToolBarView QWidget#adaptiveToolBarPopup {
    background-color: ${surface.popup};
    border: 1px solid ${control.border.default};
    color: ${text.primary};
}

ClipEditorToolBarView QWidget#adaptiveToolBarPopup[dwmBorder="true"] {
    border: none;
}

ClipEditorToolBarView QPushButton {
    padding: 0px;
    border: none;
    background-color: ${surface.sunken};
    border-radius: 0px;
}

ClipEditorToolBarView QPushButton[groupPos="first"] {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

ClipEditorToolBarView QPushButton[groupPos="last"] {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

ClipEditorToolBarView QPushButton[groupPos="only"] {
    border-radius: 4px;
}

ClipEditorToolBarView QPushButton#btnRetake {
    padding-left: 12px;
    padding-right: 12px;
}

ClipEditorToolBarView QPushButton:checked {
    background-color: ${selection.fill};
}

ClipEditorToolBarView QPushButton:checked:hover {
    background-color: ${selection.hoverFill};
}

ClipEditorToolBarView QPushButton:hover {
    background: ${control.fill.hover};
}

ClipEditorToolBarView QPushButton:pressed {
    background: ${control.fill.pressed};
}

ClipEditorToolBarView QPushButton#btnMute {
    background: ${control.fill.default};
    border: none;
}

ClipEditorToolBarView QPushButton#btnMute:hover {
    background: ${control.fill.hover};
}

ClipEditorToolBarView QPushButton#btnMute:pressed {
    background: ${control.fill.pressed};
}

ClipEditorToolBarView QPushButton#btnMute:checked {
    color: ${button.mute.checked.foreground};
    background-color: ${button.mute.checked.fill};
}

ClipEditorToolBarView QPushButton#btnMute:checked:hover {
    background-color: ${button.mute.checkedHover.fill};
}

ClipEditorToolBarView QPushButton#btnMute:checked:pressed {
    background-color: ${button.mute.checkedPressed.fill};
}

InlineEditLabel#leClipName {
    background: ${surface.sunken};
    border: none;
    height: 28px;
    border-radius: 0px;
}

InlineEditLabel#leClipName[groupPos="first"],
QLineEdit#inlineEditLineEdit[editRole="ClipName"][groupPos="first"] {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

InlineEditLabel#leClipName[groupPos="last"],
QLineEdit#inlineEditLineEdit[editRole="ClipName"][groupPos="last"] {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

InlineEditLabel#leClipName[groupPos="only"] {
    border-radius: 4px;
}

QLineEdit#inlineEditLineEdit[editRole="ClipName"] {
    background: ${surface.sunken};
    border: none;
    border-bottom: 1px solid ${border.focus};
    border-radius: 0px;
    padding: 0px 8px;
}

QLineEdit#inlineEditLineEdit[editRole="ClipName"][groupPos="only"] {
    border-radius: 4px;
}

QLineEdit#inlineEditLineEdit[editRole="Lyric"] {
    background: ${surface.sunken};
    border: 1px solid ${border.focus};
    border-radius: 2px;
    padding: 0px 2px;
}

QLineEdit#inlineEditLineEdit[editRole="Pronunciation"] {
    background: ${surface.sunken};
    border: 1px solid ${border.focus};
    border-radius: 2px;
    padding: 0px 2px;
}

TwoLevelComboBox#cbClipSinger,
ComboBox#cbClipLanguage,
ComboBox#cbPianoRollQuantize {
    background: ${surface.sunken};
    border: none;
    height: 28px;
    border-radius: 0px;
    padding-left: 12px;
    padding-right: 12px;
}

TwoLevelComboBox#cbClipSinger::menu-button,
ComboBox#cbPianoRollQuantize::menu-button {
    border: none;
}

TwoLevelComboBox#cbClipSinger:disabled {
    color: ${control.foreground.disabled};
}

TwoLevelComboBox#cbClipSinger[groupPos="first"],
ComboBox#cbClipLanguage[groupPos="first"] {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

TwoLevelComboBox#cbClipSinger[groupPos="last"],
ComboBox#cbClipLanguage[groupPos="last"] {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

TwoLevelComboBox#cbClipSinger[groupPos="only"],
ComboBox#cbClipLanguage[groupPos="only"],
ComboBox#cbPianoRollQuantize[groupPos="only"] {
    border-radius: 4px;
}

/* TimelineView */
TimelineView#pianoRollTimelineView {
    border-top-right-radius: 0px;
}

ClipEditorToolBarView QPushButton#btnAutoPageTurn[autoPageTurnAvailable="false"] {
    background-color: ${control.fill.disabled};
}

/* PianoKeyboardView */
PianoKeyboardView,
HorizontalPianoKeyboardView {
    qproperty-whiteKeyColor: ${piano.key.white};
    qproperty-blackKeyColor: ${piano.key.black};
    qproperty-dividerColor: ${piano.key.divider};
}

/* PianoRollView */
PianoRollView {
    /* border-radius: 6px; */
    border-radius: 0px;
}

PianoRollGraphicsView, PianoRollRhiWidget {
    qproperty-noteFontPixelSize: 13;
    qproperty-whiteKeyColor: ${editor.canvasAlternate};
    qproperty-blackKeyColor: ${piano.roll.blackRow};
    qproperty-octaveDividerColor: ${piano.roll.octaveDivider};
    qproperty-noteSelectedBorderColor: ${piano.roll.noteSelectedBorder};
    qproperty-noteHandleFillColor: ${piano.roll.noteHandle.fill};
    qproperty-noteHandleBorderColor: ${piano.roll.noteHandle.border};
    qproperty-noteHandleGripColor: ${piano.roll.noteHandle.grip};
    qproperty-pronunciationTextColor: ${piano.roll.pronunciation};
    qproperty-clipRangeOverlayColor: ${piano.roll.overlay};
    qproperty-paramOriginalCurveColor: ${curve.original};
    qproperty-paramEditedCurveColor: ${pitch.curveEdited};
    qproperty-barLineColor: ${editor.grid.bar};
    qproperty-beatLineColor: ${editor.grid.beat};
    qproperty-commonLineColor: ${editor.grid.subdivision};
    qproperty-playPosIndicatorColor: ${editor.playhead};
    qproperty-lastPlayPosIndicatorColor: ${editor.lastPlayhead};
    qproperty-rubberBandBorderColor: ${editor.selection.border};
    qproperty-rubberBandFillColor: ${editor.selection.fill};
}

PianoRollGraphicsView {
    qproperty-anchorColor: ${curve.anchor};
    qproperty-anchorSelectedColor: ${curve.anchorSelected};
    qproperty-anchorCurveColor: ${curve.anchor};
    qproperty-anchorPreviewColor: ${curve.anchorSelected};
    qproperty-splitLineColor: ${editor.splitLine};
    qproperty-paramGraduateColor: ${curve.guide};
    qproperty-paramBackgroundLayerColor: ${editor.canvasAlternate};
}

PianoRollRhiWidget {
    qproperty-anchorColor: ${curve.anchor};
    qproperty-anchorSelectedColor: ${curve.anchorSelected};
    qproperty-anchorCurveColor: ${curve.anchor};
    qproperty-anchorPreviewColor: ${curve.anchorSelected};
    qproperty-splitLineColor: ${editor.splitLine};
}

PianoRollView>QLabel#lbNullClipTip {
    color: ${control.foreground.disabled};
}

ParamEditorGraphicsView {
    background: ${editor.canvas};
    border-radius: 0px;
    border-bottom-right-radius: 6px;
    qproperty-paramGraduateColor: ${curve.guide};
    qproperty-paramOriginalCurveColor: ${curve.original};
    qproperty-paramEditedCurveColor: ${curve.edited};
    qproperty-paramUseTrackColorForEditedCurve: true;
    qproperty-paramBackgroundLayerColor: ${editor.canvasAlternate};
    qproperty-anchorColor: ${curve.anchor};
    qproperty-anchorSelectedColor: ${curve.anchorSelected};
    qproperty-anchorCurveColor: ${curve.anchor};
    qproperty-anchorPreviewColor: ${curve.anchorSelected};
}

PhonemeView {
    background: ${editor.canvas};
    /* border-bottom-right-radius: 6px; */
}

LyricWrapView {
    background: transparent;
    border: 1px solid ${border.default};
    border-radius: 4px;
    padding: 2px;
}

QWidget#pianoRollTopLeftSpacing {
    background: ${piano.roll.background};
    /* border-top-left-radius: 6px; */
}

/* Keyboard-column lane title cells; the border-top comes from the shared
   InfoLaneHeaderView rule so the lane separators keep running across the full
   width like the track editor */
InfoLaneHeaderView#pianoRollTempoLaneHeader,
InfoLaneHeaderView#pianoRollTimeSignatureLaneHeader {
    background: ${piano.roll.background};
}

DividerLine#pianoRollLaneBottomDivider {
    qproperty-lineColor: ${border.subtle};
    qproperty-lineMargin: 0px;
}

QWidget#pianoRollBottomLeftSpacing {
    background: ${piano.roll.background};
    /* border-bottom-left-radius: 6px; */
}

/* PianoKeyboardView {
    border-bottom-left-radius: 6px;
} */

PianoRollEditorView {
    background: ${piano.roll.background};
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px
}

PianoRollEditorView::handle:vertical {
    height: 12px;
    background-color: ${surface.panel};
}

ParamEditorToolBarView {
    background: ${surface.panel};
    border-top: 1px solid ${border.subtle};
}

ParamEditorToolBarView>QLabel#lbForegroundParam,
ParamEditorToolBarView>QLabel#lbBackgroundParam {
    color: ${control.foreground.disabled};
}

ParamEditorToolBarView>ComboBox#cbForegroundParam,
ParamEditorToolBarView>ComboBox#cbBackgroundParam {
    border: none;
    padding-left: 8px;
    background: transparent;
    color: ${text.secondary};
}

ParamEditorToolBarView>ComboBox#cbForegroundParam:hover,
ParamEditorToolBarView>ComboBox#cbBackgroundParam:hover {
    color: ${text.emphasis};
}

ParamEditorToolBarView>ToolButton#btnSwap {
    border: none;
    background: transparent;
}

ParamEditToolBarView>Button {
    width: 24px;
    height: 24px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0px;
    border: none;
    border-radius: 4px;
    background: transparent;
}

ParamEditToolBarView>Button:hover {
    background: ${control.fill.hover};
}

ParamEditToolBarView>Button:pressed {
    background: ${control.fill.pressed};
}

ParamEditToolBarView>Button:checked {
    background: ${selection.fill};
}

ParamEditToolBarView>Button:checked:hover {
    background: ${selection.hoverFill};
}

ParamEditorToolBarView Button#btnPrevKeyframe,
ParamEditorToolBarView Button#btnNextKeyframe {
    padding: 0px;
    border: none;
    background: transparent;
}

ParamEditorInfoArea {
    background: ${surface.panel};
    border-bottom-left-radius: 6px;
}

ParamEditorInfoArea>QLabel {
    color: ${control.foreground.disabled};
}

QLabel#clipEditorPlaceholder {
    color: ${control.foreground.disabled};
    font-size: 14px;
}

QWidget#speakerMixEmptyState {
    background-color: ${speakerMix.emptyState.fill};
}

QWidget#speakerMixEmptyState QLabel {
    color: ${speakerMix.emptyState.text};
}

PhonemeView {
    qproperty-hintTextColor: ${phoneme.hint};
    qproperty-textColor: ${phoneme.text};
    qproperty-positionLineColor: ${phoneme.positionLine};
    qproperty-lastPositionLineColor: ${editor.lastPlayhead};
    qproperty-noteBoundaryColor: ${phoneme.noteBoundary};
    qproperty-waveformColor: ${phoneme.waveform};
}

AudioView {
    border-radius: 0px;
}

/* Shared colours. Qt warns on every polish when a qproperty-* name is not
   declared by every class in a selector list, so backend-only properties
   belong in their own rules below. */
AudioViewGraphicsView, AudioViewRhiWidget {
    qproperty-laneBackgroundColor: ${editor.canvasAlternate};
    qproperty-laneSeparatorColor: ${border.subtle};
    qproperty-waveformCenterLineColor: ${piano.roll.octaveDivider};
    qproperty-clipRangeOverlayColor: ${piano.roll.overlay};
    qproperty-barLineColor: ${editor.grid.bar};
    qproperty-beatLineColor: ${editor.grid.beat};
    qproperty-commonLineColor: ${editor.grid.subdivision};
    qproperty-playPosIndicatorColor: ${editor.playhead};
    qproperty-lastPlayPosIndicatorColor: ${editor.lastPlayhead};
}

/* The QGraphicsView backend shows an empty canvas through its style background. */
AudioViewGraphicsView {
    background: ${editor.canvasAlternate};
}

/* Only the RHI backend clears the frame itself when no clip content is drawable. */
AudioViewRhiWidget {
    qproperty-emptyViewBackgroundColor: ${editor.canvasAlternate};
}

AudioChannelAxisView {
    qproperty-tickColor: ${timeline.ruler.barTick};
    qproperty-labelColor: ${timeline.ruler.beatScale};
    qproperty-infiniteLabelColor: ${control.foreground.disabled};
    qproperty-separatorColor: ${border.subtle};
    qproperty-channelTagColor: ${text.secondary};
    qproperty-laneBackgroundColor: ${surface.panel};
}

AudioView>QLabel#lbNullClipTip {
    color: ${control.foreground.disabled};
}

QWidget#audioViewTopLeftSpacing {
    background: ${surface.panel};
}



ClipEditorToolBarView {
    qproperty-iconColor: ${icon.primary};
    qproperty-iconDisabledColor: ${icon.disabled};
    qproperty-iconOnColor: ${accent.default};
    qproperty-iconOnDisabledColor: ${accent.muted};
}

ParamEditToolBarView {
    qproperty-iconColor: ${icon.primary};
    qproperty-iconDisabledColor: ${icon.disabled};
    qproperty-iconOnColor: ${accent.default};
    qproperty-iconOnDisabledColor: ${accent.muted};
}
