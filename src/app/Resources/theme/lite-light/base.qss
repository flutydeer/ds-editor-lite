QWidget {
    outline: none;
}

/* Opaque background is the default so the first frame after show() is already
   themed (the transparentWindow property is only set after QEvent::Show). */
Dialog,
Window,
QMainWindow,
DetachedPanelWindow {
    background: ${surface.window};
}

Dialog[transparentWindow="true"],
Window[transparentWindow="true"],
QMainWindow[transparentWindow="true"],
DetachedPanelWindow[transparentWindow="true"] {
    background: transparent
}
