FillLyric--LyricWrapView {
    background: ${surface.input};
    border: 1px solid ${border.default};
    border-radius: 6px;

    /* Single color values (NoBrush / #AARRGGBB / theme token) or legacy r,g,b,a[,width] */
    qproperty-cellBackgroundBrush: cellBackgroundBrush(NoBrush|${control.fill.hover}|${selection.fill}); /* Normal|Hovered|Selected */
    qproperty-cellBorderPen: cellBorderPen(${border.default},2|${border.strong},2|${selection.border},2); /* color[,width] Normal|Hovered|Selected */
    qproperty-cellLyricPen: cellLyricPen(${text.primary}|${text.primary}|${text.primary}|${text.primary}); /* Normal|MultiTone|Revised|G2pError */
    qproperty-cellSyllablePen: cellSyllablePen(${text.primary}|${accent.default}|${status.warning}|${status.error}); /* Normal|MultiTone|Revised|G2pError */

    qproperty-cellListSelectedFillBrush: cellListSelectedFillBrush(${selection.inactiveFill}); /* whole-line selection background */
    qproperty-handleBackgroundBrush: handleBackgroundBrush(${border.default}|${control.fill.hover}|${accent.default}); /* Normal|Hovered|Selected */
    qproperty-splitterPen: splitterPen(${border.strong},1); /* color,width */
}
