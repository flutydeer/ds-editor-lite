{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "qmsetup",
    {
      "name": "qwindowkit",
      "features": [
        "widgets"
      ]
    },
    "qbreakpad",
    {
      "name": "rtmidi",
      "features": [
        {
          "name": "alsa",
          "platform": "linux"
        }
      ]
    },
    "interval-tree",
    "cpp-pinyin",
    "cpp-kana",
    "opendspx",
    "yaml-cpp",
    "wavpack",
    "libsndfile",
    "tinyexpr",
    {
      "name": "synthrt",
      "features": []
    },
    {
      "name": "talcs",
      "features": [
        "device",
        {
          "name": "asio",
          "platform": "windows & !(arm | uwp)"
        },
        {
          "name": "alsa",
          "platform": "linux"
        },
        {
          "name": "pulseaudio",
          "platform": "linux"
        },
        "format",
        "midi",
        "dspx",
        "widgets"
      ]
    },
    "wolf-midi"
  ],
  "features": {
    "cuda12": {
      "description": "Enable synthrt (dsinfer) CUDA 12.x support",
      "dependencies": [
        {
          "name": "synthrt",
          "features": [
            "cuda12"
          ]
        }
      ],
      "supports": "!osx & !arm & !arm64"
    }
  },
  "vcpkg-configuration": {
    "overlay-ports": [
      "../vcpkg-project/ports",
      "../vcpkg/ports"
    ],
    "overlay-triplets": [
      "../vcpkg/triplets"
    ]
  }
}
