+    // Bound each ONNX run while retaining context that is discarded after inference.
+    constexpr int64_t kModelSampleRate = 16000;
+    constexpr int64_t kModelHopSamples = 160;
+    constexpr int64_t kMaxInferenceSamples = 30 * kModelSampleRate;
+    constexpr int64_t kInferenceContextSamples = kModelSampleRate;
+    constexpr int64_t kInferenceCoreSamples =
+        kMaxInferenceSamples - 2 * kInferenceContextSamples;
+
+    static_assert(kInferenceCoreSamples > 0);
+    static_assert(kInferenceCoreSamples % kModelHopSamples == 0);
+    static_assert(kInferenceContextSamples % kModelHopSamples == 0);
+
+}
