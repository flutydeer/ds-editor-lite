# Generated by the wolf-lang-packages port.
#
#   find_package(wolf-lang-packages CONFIG)
#   SynthUnit::setPackagePaths({ WOLF_LANG_PACKAGES_DIR })
#
# The directory is the Package search root: one subdirectory per package, which is the layout that
# the loader scans. A plain find_path does not locate the directory, because it contains no header
# or library. The name of the installed-directory variable also differs across vcpkg versions. The
# path is therefore resolved relative to this file.

get_filename_component(_wolf_lang_prefix "${CMAKE_CURRENT_LIST_DIR}" DIRECTORY) # share/
get_filename_component(_wolf_lang_prefix "${_wolf_lang_prefix}" DIRECTORY)      # prefix

set(WOLF_LANG_PACKAGES_DIR "${_wolf_lang_prefix}/share/wolf/packages")
set(WOLF_LANG_PACKAGES_BUNDLE_VERSION "@WOLF_LANG_PACKAGES_BUNDLE_VERSION@")
set(WOLF_LANG_PACKAGES_INSTALLED "@WOLF_LANG_PACKAGES_INSTALLED@")
set(WOLF_LANG_PACKAGES_FOUND TRUE)

unset(_wolf_lang_prefix)
