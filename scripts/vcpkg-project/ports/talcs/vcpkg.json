{
  "name": "talcs",
  "version": "0.0.1.1",
  "description": "A high-level Qt audio library",
  "homepage": "https://talcs.sjimo.dev/",
  "license": "LGPL-3.0-or-later",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "qmsetup",
      "host": true
    },
    "interval-tree"
  ],
  "features": {
    "device": {
      "description": "talcs::Device"
    },
    "asio": {
      "description": "talcs::Asio",
      "supports": "windows",
      "dependencies": [
        "asiosdk"
      ]
    },
    "alsa": {
      "description": "talcs::Alsa",
      "supports": "linux"
    },
    "pulseaudio": {
      "description": "talcs::PulseAudio",
      "supports": "linux"
    },
    "pipewire": {
      "description": "talcs::PipeWire",
      "supports": "linux"
    },
    "jack": {
      "description": "talcs::Jack",
      "supports": "linux"
    },
    "format": {
      "description": "talcs::Format",
      "dependencies": [
        "libsndfile",
        "wavpack",
        "r8brain-free-src"
      ]
    },
    "midi": {
      "description": "talcs::Midi",
      "dependencies": [
        "rtmidi"
      ]
    },
    "remote": {
      "description": "talcs::Remote",
      "dependencies": [
        "rpclib",
        "boost-interprocess"
      ]
    },
    "dspx": {
      "description": "talcs::Dspx"
    },
    "gui": {
      "description": "talcs::Gui"
    },
    "widgets": {
      "description": "talcs::Widgets"
    }
  },
  "default-features": [
    "device",
    "format",
    "midi"
  ]
}
