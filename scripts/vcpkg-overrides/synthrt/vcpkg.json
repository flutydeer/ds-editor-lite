{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "synthrt",
  "version-string": "onnxruntime-builds-uptake",
  "description": [
    "SVS Synthesis Runtime Library, main line.",
    "Overrides the shared overlay's synthrt port, which pins the refactor line."
  ],
  "homepage": "https://github.com/diffscope/synthrt",
  "license": "Apache-2.0",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "qmsetup",
    "stduuid",
    "stdcorelib",
    "stdcorelib-plugin",
    "blake3",
    "sparsepp",
    "bit7z"
  ],
  "features": {
    "onnx": {
      "description": "Build dsinfer and its ONNX Runtime driver (DirectML on Windows, CPU elsewhere)",
      "dependencies": [
        "onnxruntime-builds"
      ]
    },
    "cuda12": {
      "description": "Bring in the CUDA 12.x flavour of ONNX Runtime for dsinfer's driver",
      "dependencies": [
        {
          "name": "synthrt",
          "default-features": false,
          "features": [
            "onnx"
          ]
        },
        {
          "name": "onnxruntime-builds",
          "features": [
            "cuda12"
          ]
        }
      ],
      "supports": "x64 & (windows | linux)"
    }
  }
}
