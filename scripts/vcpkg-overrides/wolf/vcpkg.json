{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "wolf",
  "version": "0.1.0.0",
  "description": [
    "Orchestratable Linguistic Framework: the linguist contribution category layered on synthrt."
  ],
  "homepage": "https://github.com/diffscope/wolf",
  "license": "Apache-2.0",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "qmsetup",
    "stdcorelib",
    "stdcorelib-plugin",
    "blake3",
    "re2",
    "cpp-pinyin",
    "luajit",
    "synthrt"
  ],
  "features": {
    "onnx": {
      "description": "Build the model backed G2P variant, which needs dsinfer and its ONNX Runtime driver",
      "dependencies": [
        {
          "name": "synthrt",
          "default-features": false,
          "features": [
            "onnx"
          ]
        }
      ]
    }
  }
}
