# Replace one managed plugin-library tree, so removed or renamed plugins cannot survive an update.
if(NOT IS_DIRECTORY "${source}" OR NOT DEFINED destination OR destination STREQUAL "")
    message(FATAL_ERROR "Plugin staging requires an existing source tree and a destination")
endif()
if(IS_SYMLINK "${destination}")
    message(FATAL_ERROR "Plugin staging destination must not be a symbolic link: ${destination}")
endif()
file(REAL_PATH "${source}" _source_path)
file(REAL_PATH "${destination}" _destination_path)
cmake_path(IS_PREFIX _source_path "${_destination_path}" NORMALIZE _destination_in_source)
cmake_path(IS_PREFIX _destination_path "${_source_path}" NORMALIZE _source_in_destination)
if(_destination_in_source OR _source_in_destination)
    message(FATAL_ERROR "Plugin staging source and destination must be separate trees")
endif()
file(REMOVE_RECURSE "${destination}")
file(COPY "${source}/" DESTINATION "${destination}" USE_SOURCE_PERMISSIONS)
